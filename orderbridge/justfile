default:
    @just --list

format:
    ruff check --select I --fix ./
    ruff format ./

fix:
    just format
    ruff check --fix

check:
    just fix
    mypy .

test-db:
    docker run --name="orderbridge_test-postgres-$(date +%s)" \
      -e POSTGRES_PASSWORD=dbpasswd \
      -e POSTGRES_USER=orderbridge \
      -e POSTGRES_DB=orderbridgedb \
      -p 5437:5432 \
      -d postgres:15 || true

stop-test-db:
    docker stop $(docker ps -a -q --filter="name=orderbridge_test-postgres") || true

rm-test-db:
    docker rm $(docker ps -a -q --filter="name=orderbridge_test-postgres") || true

dev-db:
    docker run --name="orderbridge_dev-postgres-$(date +%s)" \
      -e POSTGRES_PASSWORD=dbpasswd \
      -e POSTGRES_USER=orderbridge \
      -e POSTGRES_DB=orderbridgedb \
      -p 5436:5432 \
      -d postgres:15 || true

stop-dev-db:
    docker stop $(docker ps -a -q --filter="name=orderbridge_dev-postgres") || true

rm-dev-db:
    docker rm $(docker ps -a -q --filter="name=orderbridge_dev-postgres") || true

up:
    just stop-test-db rm-test-db stop-dev-db rm-dev-db
    docker compose up --build

down:
    docker compose down -v

test-env:
    just stop-test-db rm-test-db stop-dev-db rm-dev-db test-db

dev-env:
    just stop-test-db rm-test-db stop-dev-db rm-dev-db dev-db
